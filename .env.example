# Rescope Surveys — environment template
# Guides: docs/README.md (dev · Docker Hub · production · CI/CD)
# Local npm dev (postgres container only): localhost:5433
DATABASE_URL=postgresql://rescopesurveys:rescopesurveys@localhost:5433/rescopesurveys
POSTGRES_USER=rescopesurveys
POSTGRES_PASSWORD=rescopesurveys
POSTGRES_DB=rescopesurveys

# API server (3001 is often taken by other dev apps — use 3003 to match Vite proxy)
PORT=3003
NODE_ENV=development

# Auth
JWT_SECRET=change-me-in-production
# Seals authenticator secrets at rest. Required before two-factor enrollment.
# openssl rand -base64 48
# TOTP_ENCRYPTION_KEY=
# ACCESS_TOKEN_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_IN=30d
# COOKIE_SECURE=false
# CORS_ORIGIN=http://localhost:5173
# Production (required): comma-separated allowlist. Never true or *.
# CORS_ORIGIN=https://app.rescopesurveys.com,https://rescopesurveys.com,https://www.rescopesurveys.com,https://surveys.rescopesurveys.com
# AUTH_ALLOW_BEARER=true

# Account emails — invites, email confirmation, password reset
# Development default: EMAIL_TRANSPORT=log (links are logged; read them at
# GET /api/internal/dev/mailbox?to=<email>). Production requires smtp + SMTP_URL.
# EMAIL_TRANSPORT=log
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Mailgun example (URL-encode @ in the SMTP username as %40):
# SMTP_URL=smtps://postmaster%40mg.example.com:MAILGUN_SMTP_PASSWORD@smtp.mailgun.org:465
# EMAIL_FROM=Rescope Surveys <no-reply@rescopesurveys.com>
# APP_URL=http://localhost:5173   # base URL used inside emailed links

# Bootstrap (development defaults — seed runs when NODE_ENV=development)
# SEED_DEFAULT_ACCOUNTS=true
# RUN_PLATFORM_LIST_MIGRATION=true
# REQUIRE_STRONG_JWT=false
# RATE_LIMIT_RELAXED=true
# RATE_LIMIT_DISABLED=true   # load tests only — skips all API rate limits
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_REDIS_REQUIRED=false
# INTERNAL_API_SECRET=change-me-in-production
# Required in production Compose for /api/internal/caddy-ask.

# Client feature flag (Phase B1+)
# VITE_USE_API=true

# Docker full stack (partner pull — no .env required):
#   docker compose pull && docker compose up -d
#   open http://localhost:8080  →  admin / admin123
#
# Docker full stack (production VPS — see docs/DEPLOY.md):
# - Set JWT_SECRET to a strong random value (32+ characters) before `docker compose up`
# - Set POSTGRES_PASSWORD (do not use the local default in production)
# - Set SMTP_URL (and EMAIL_FROM) — the API refuses to start in production without real mail
# - Use COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml (disables seed, enables HTTPS cookies)
# - Partner (pull images):  docker compose pull && docker compose up -d
# - Developer (build local): docker compose up --build -d
# - App UI: http://localhost:8080  (override with WEB_HOST_PORT)
#
# Docker full stack (development override):
# - docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
#
# Postgres host port (local npm dev only): npm run db:up
#   Default host port 5433 (override with POSTGRES_HOST_PORT)
#
# Docker Hub (publish pre-built images — set your username if not vitomirov):
# DOCKERHUB_USER=vitomirov
# IMAGE_TAG=latest
#
# ── Production VPS deploy (see docs/DEPLOY.md) ─────────────────────────────
# Do not copy this file to the VPS. On the server, generate secrets with:
#   IMAGE_TAG=v0.1.0 ./scripts/deploy/init-env.sh
# That writes POSTGRES_PASSWORD and JWT_SECRET via openssl (32+ chars, no placeholders).
#
# WEB_HOST_PORT=8080
#   Host port for the web container (nginx). Internal only — docker-compose.prod.yml
#   binds it to 127.0.0.1 so the host Caddy can reach it and the internet cannot.
#   Keep it a bare port number and keep it in sync with docker/caddy/Caddyfile.
#
# DOCKERHUB_USER / IMAGE_TAG
#   Which images the VPS runs. Use an explicit version tag (IMAGE_TAG=v0.1.0)
#   rather than `latest` so a rollback is a one-line change plus a redeploy.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
#   Set on the VPS only, so bare `docker compose pull` / `up -d` include the
#   production override. Leave it unset locally.
#
# Caddy is not configured here — TLS and domains live on the host in
# /etc/caddy/Caddyfile (template: docker/caddy/Caddyfile).
