// Rescope Surveys — multi-organization SaaS schema
// Same codebase supports single-tenant enterprise deployments via env + isolated DB.
// DB columns use entity-prefixed names (e.g. organization_name) for clarity in raw SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @map("organization_name")
  settings  Json     @default("{}") @map("organization_settings")
  createdAt DateTime @default(now()) @map("organization_created_at")

  users          User[]
  surveys        Survey[]
  responses      Response[]
  surveyExports  SurveyExport[]
  clients        Client[]
  topics         Topic[]
  surveyTypes    SurveyType[]
  subscription   Subscription?
  invoices       Invoice[]
  authTokens     AuthToken[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @map("user_email")
  username       String?  @map("user_username")
  passwordHash   String   @map("user_password_hash")
  name           String?  @map("user_name")
  avatarUrl      String?  @map("user_avatar_url")
  role           String   @default("editor") @map("user_role")
  // Product access is separate from admin/editor. Panel requires an Enterprise plan.
  canUseBuilder  Boolean  @default(true) @map("user_can_use_builder")
  canUsePanel    Boolean  @default(false) @map("user_can_use_panel")
  tokenVersion   Int      @default(0) @map("user_token_version")
  emailVerifiedAt DateTime? @map("user_email_verified_at")
  totpSecret     String?  @map("user_totp_secret")
  totpEnabled    Boolean  @default(false) @map("user_totp_enabled")
  createdAt      DateTime @default(now()) @map("user_created_at")
  updatedAt      DateTime @updatedAt @map("user_updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  surveys          Survey[]         @relation("SurveyCreator")
  surveyExports    SurveyExport[]
  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]

  @@unique([email])
  @@unique([organizationId, username])
  @@map("users")
}

/// One-time, single-use links: team invites, password resets, email verification.
/// Only the SHA-256 hash of the token is stored; the raw token lives in the email link.
model AuthToken {
  id             String    @id @default(uuid())
  type           String    @map("token_type")
  tokenHash      String    @unique @map("token_hash")
  email          String    @map("token_email")
  organizationId String?   @map("organization_id")
  userId         String?   @map("user_id")
  role           String?   @map("invite_role")
  canUseBuilder  Boolean   @default(true) @map("invite_can_use_builder")
  canUsePanel    Boolean   @default(false) @map("invite_can_use_panel")
  invitedById    String?   @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, email])
  @@index([organizationId, type])
  @@map("auth_tokens")
}

/// One-time panel login codes. The raw code is never stored.
model PanelOauthCode {
  id             String    @id @default(uuid())
  codeHash       String    @unique @map("code_hash")
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  redirectUri    String    @map("redirect_uri")
  codeChallenge  String    @map("code_challenge")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("panel_oauth_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Survey {
  id             String   @id
  organizationId String   @map("organization_id")
  createdById    String?  @map("survey_created_by_id")
  tenantId       String?  @map("tenant_id")
  publicPath     String?  @map("survey_public_path")
  survey         Json     @map("survey_data")
  items          Json     @default("[]") @map("survey_items")
  revision       Int      @default(1) @map("survey_revision")
  createdAt      DateTime @default(now()) @map("survey_created_at")
  updatedAt      DateTime @updatedAt @map("survey_updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  responses    Response[]
  surveyExports SurveyExport[]
  dncEntries   DncEntry[]

  @@unique([publicPath])
  @@index([organizationId])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([organizationId, createdById])
  @@map("surveys")
}

model Response {
  id             String   @id
  surveyId       String   @map("survey_id")
  organizationId String   @map("organization_id")
  /// JSON payload: { responses: { [questionId]: answer }, companions, terminatedBy, ... }
  /// Matrix answers: { [rowId]: columnId | columnId[] } — see answerSchemaVersion in payload
  payload        Json     @map("response_payload")
  status         String   @map("response_status")
  timestamp      DateTime @default(now()) @map("response_timestamp")
  /// Set only for public creates. Null rows keep the previous UUID update.
  writeKeyHash   String?  @map("response_write_key_hash")

  survey       Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([organizationId])
  @@index([surveyId, status])
  @@index([organizationId, surveyId])
  @@map("responses")
}

/// Append-only. No foreign keys, so a deleted organization can still be named.
model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String   @map("audit_action")
  targetEntity   String   @map("target_entity")
  targetId       String   @map("target_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([targetEntity, targetId])
  @@map("audit_events")
}

model SurveyExport {
  id             String   @id @default(uuid())
  surveyId       String   @map("survey_id")
  organizationId String   @map("organization_id")
  exportedById   String?  @map("exported_by_id")
  exportedAt     DateTime @default(now()) @map("exported_at")
  rowCount       Int      @map("row_count")
  filters        Json?    @map("export_filters")

  survey       Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exportedBy   User?        @relation(fields: [exportedById], references: [id], onDelete: SetNull)

  @@index([surveyId, exportedAt(sort: Desc)])
  @@index([organizationId])
  @@map("survey_exports")
}

model Client {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String   @map("client_name")
  createdAt      DateTime @default(now()) @map("client_created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("clients")
}

model Topic {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String   @map("topic_name")
  createdAt      DateTime @default(now()) @map("topic_created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("topics")
}

model SurveyType {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String   @map("survey_type_name")
  createdAt      DateTime @default(now()) @map("survey_type_created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("survey_types")
}

model DncEntry {
  id       String @id @default(uuid())
  surveyId String @map("survey_id")
  email    String @map("dnc_email")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, email])
  @@index([surveyId])
  @@map("dnc_entries")
}

model Subscription {
  id                 String   @id @default(uuid())
  organizationId     String   @unique @map("organization_id")
  planId             String   @map("subscription_plan_id")
  status             String   @default("trialing") @map("subscription_status")
  seats              Int      @default(5) @map("subscription_seats")
  priceCents         Int      @default(0) @map("subscription_price_cents")
  currency           String   @default("USD") @map("subscription_currency")
  currentPeriodStart DateTime @map("subscription_period_start")
  currentPeriodEnd   DateTime @map("subscription_period_end")
  createdAt          DateTime @default(now()) @map("subscription_created_at")
  updatedAt          DateTime @updatedAt @map("subscription_updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Invoice {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  amountCents    Int       @map("invoice_amount_cents")
  currency       String    @default("USD") @map("invoice_currency")
  status         String    @default("draft") @map("invoice_status")
  description    String?   @map("invoice_description")
  periodStart    DateTime? @map("invoice_period_start")
  periodEnd      DateTime? @map("invoice_period_end")
  dueDate        DateTime? @map("invoice_due_date")
  paidAt         DateTime? @map("invoice_paid_at")
  createdAt      DateTime  @default(now()) @map("invoice_created_at")
  updatedAt      DateTime  @updatedAt @map("invoice_updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("invoices")
}
