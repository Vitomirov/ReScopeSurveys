{
  "name": "survey-builder-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=../.env --watch src/index.js",
    "dev:all": "npm run dev:all --prefix ..",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "migrate:platform-lists": "node scripts/migrate-platform-lists.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "10.2.2",
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "fastify": "5.12.3",
    "isomorphic-dompurify": "^2.36.0",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  }
}
