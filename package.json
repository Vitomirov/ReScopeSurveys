{
  "name": "survey-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently -n vite,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "dev:docker": "./scripts/dev/start-postgres.sh && VITE_USE_API=true npm run dev:all",
    "db:up": "./scripts/dev/start-postgres.sh",
    "db:reset": "./scripts/dev/start-postgres.sh --reset",
    "db:generate": "npm run db:generate --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:migrate:dev": "npm run db:migrate:dev --prefix server",
    "build": "vite build",
    "build:analyze": "vite build && node -e \"const fs=require('fs');const d='dist/assets';const files=fs.readdirSync(d).filter(f=>f.endsWith('.js'));console.log('JS chunks:',files.length);files.forEach(f=>console.log(f, (fs.statSync(d+'/'+f).size/1024).toFixed(1)+'KB'))\"",
    "preview": "vite preview",
    "check:registries": "node scripts/check/question-registries.js",
    "test:phase2": "node --test scripts/tests/unit/builder-layout.test.mjs",
    "test:dnc-phase2": "node --test scripts/tests/integration/dnc/dnc-enforcement.test.mjs",
    "test:phase3": "node --test scripts/tests/unit/question-numbering-piping.test.mjs",
    "test:phase4": "node --test scripts/tests/unit/reducer-helpers.test.mjs",
    "test:track-a": "node --test scripts/tests/unit/builder-layout.test.mjs scripts/tests/unit/question-numbering-piping.test.mjs scripts/tests/unit/reducer-helpers.test.mjs",
    "test:rbac1": "node --test scripts/tests/integration/auth/auth-foundation.test.mjs",
    "test:rbac2": "node --test scripts/tests/integration/rbac/ownership.test.mjs",
    "test:rbac3": "node --test scripts/tests/integration/rbac/rbac-scopes.test.mjs",
    "test:rbac4": "node --test scripts/tests/unit/permissions.test.mjs",
    "test:rbac5": "node --test scripts/tests/integration/rbac/employees.test.mjs",
    "test:rbac6": "node --test scripts/tests/integration/rbac/billing.test.mjs",
    "test:config": "node --test scripts/tests/unit/config.test.mjs scripts/tests/unit/hardening.test.mjs",
    "test:auth-cookies": "node --test scripts/tests/integration/auth/auth-cookies.test.mjs",
    "test:auth-lifecycle": "node --test scripts/tests/integration/auth/account-lifecycle.test.mjs",
    "test:security:ownership": "node --test scripts/tests/integration/security/response-ownership.test.mjs",
    "test:security": "node --test scripts/tests/integration/security/*.test.mjs",
    "migrate:platform-lists": "npm run migrate:platform-lists --prefix server",
    "test:brand0": "node --test scripts/tests/unit/brand-theme-shared.test.mjs",
    "test:brand1": "node --test scripts/tests/integration/brand/brand-enforcement.test.mjs",
    "test:brand2": "node --test scripts/tests/integration/brand/embed-protocol.test.mjs",
    "test:brand3": "node --test scripts/tests/integration/brand/org-domains.test.mjs",
    "test:brand": "node --test scripts/tests/unit/brand-theme-shared.test.mjs scripts/tests/integration/brand/brand-enforcement.test.mjs scripts/tests/integration/brand/embed-protocol.test.mjs scripts/tests/integration/brand/org-domains.test.mjs",
    "test:load": "./scripts/load/run-load-test.sh",
    "test:load:quick": "./scripts/load/run-load-test.sh --quick"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dompurify": "^3.4.13",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "browserslist": "^4.29.3",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Opera versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions"
  ]
}
