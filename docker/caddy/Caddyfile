# Rescope Surveys — host Caddy (VPS), in front of the Docker stack.
#
# Install on the VPS (prefer the bootstrap script):
#   sudo ./scripts/deploy/bootstrap-vps.sh
#   # or: sudo cp docker/caddy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Caddy terminates TLS (Let's Encrypt certificates are issued and renewed
# automatically) and forwards plain HTTP to the web container, which is
# published on loopback only. The nginx inside that container keeps serving
# the React build and proxying /api/ to the api container — unchanged.
#
# app.rescopesurveys.com → SaaS (login, dashboard, builder — no marketing homepage).
# rescopesurveys.com + www → marketing site (#/home); CTAs send auth to app host (see shared/siteHosts.js).
# surveys.* → public survey taker; stays embeddable (Professional+ iframe snippet).
#
# Full guide: docs/DEPLOY.md
#
# Enterprise custom domains (surveys.client.com):
# - Customer adds TXT + A records, then clicks "Check DNS" in the app.
# - Caddy issues on-demand certificates for verified survey hosts only
#   (see /api/internal/caddy-ask on the API). Set INTERNAL_API_SECRET in .env
#   and pass it as ?token= on the ask URL below.

{
	on_demand_tls {
		ask http://127.0.0.1:8080/api/internal/caddy-ask?token={env.INTERNAL_API_SECRET}
	}
}

(proxy_to_web) {
	# WEB_HOST_PORT from .env — keep both values in sync if you change it.
	# Overwrite forwarded-for with the TCP peer so clients cannot spoof it.
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

(browser_security) {
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

app.rescopesurveys.com, rescopesurveys.com, www.rescopesurveys.com {
	import browser_security
	header X-Frame-Options SAMEORIGIN
	import proxy_to_web
}

surveys.rescopesurveys.com {
	import browser_security
	import proxy_to_web
}

# Verified enterprise survey hosts (on-demand TLS; no manual block per customer).
:443 {
	tls {
		on_demand
	}
	import browser_security
	import proxy_to_web
}

# Optional: send www to the apex domain instead of serving both.
# Replace the www entry above with this block if you want a single canonical host.
#
# www.rescopesurveys.com {
# 	redir https://rescopesurveys.com{uri} permanent
# }
